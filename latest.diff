+static bool val_nvm_range_is_valid(size_t offset, size_t size)
+{
+    if (size > SIZE_MAX - offset) {
+        return false;
+    }
+
+    if (offset > (size_t)UINT32_MAX) {
+        return false;
+    }
+
+    if (size > (size_t)UINT32_MAX) {
+        return false;
+    }
+
+    if (offset > ((size_t)UINT32_MAX - size)) {
+        return false;
+    }
+
+    return true;
+}
